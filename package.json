{
  "name": "i-modal-vue",
  "version": "1.0.0",
  "description": "A reusable Modal component for Vue 3",
  "author": "Ilham Gurbanly",
  "license": "MIT",
  "type": "module",
   "files": [
    "dist"
  ],
  "main": "./dist/i-modal-vue.umd.js",
  "module": "./dist/i-modal-vue.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/i-modal-vue.es.js",
      "require": "./dist/i-modal-vue.umd.js"
    },
    "./dist/style.css": "./dist/i-modal-vue.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vue-tsc": "^3.3.8"
  }
}

